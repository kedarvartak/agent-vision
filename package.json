{
  "name": "agent-vision-mcp",
  "version": "0.1.2",
  "type": "module",
  "description": "Browser-first MCP server that gives agents visual access to live tabs through Chrome DevTools Protocol.",
  "bin": {
    "agent-vision-mcp": "dist/mcp-stdio.js"
  },
  "main": "dist/mcp-stdio.js",
  "exports": {
    ".": "./dist/mcp-stdio.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/mcp-stdio.js",
    "demo-cdp": "node dist/cdp-demo.js"
  },
  "keywords": [
    "mcp",
    "codex",
    "chrome-devtools-protocol",
    "browser",
    "vision",
    "agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kedarvartak/agent-vision.git"
  },
  "homepage": "https://github.com/kedarvartak/agent-vision#readme",
  "bugs": {
    "url": "https://github.com/kedarvartak/agent-vision/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.3"
  }
}
